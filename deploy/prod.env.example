# Production environment for the agentic-prezi control-plane (#1 skeleton).
# Set these in Coolify's "Environment Variables" UI for the app — NOT in the repo.
# This file is a TEMPLATE: it contains NO secrets and is safe to commit. Real values
# (email API key, GlitchTip DSN, Nous key) are entered in Coolify's secret store only.

# --- core ---
NODE_ENV=production
PORT=8787
BASE_DOMAIN=themultiverse.school
# TLS is terminated by Cloudflare + Traefik in front of us, so cookies must be Secure.
COOKIE_SECURE=true

# --- hard guard ---
# DEV_AUTH_BYPASS is REFUSED at startup when NODE_ENV=production (see src/config.ts).
# Do NOT set it here. Leaving it unset is correct; the app throws if it is truthy in prod.

# --- persistence (maps to the Coolify-mounted volume at /app/data) ---
DATA_DIR=/app/data
DB_PATH=/app/data/app.db

# --- email (REQUIRED for prod login — magic links cannot be delivered without it) ---
# Pick + vet a transactional provider (node:https POST, no SDK). Until this is wired,
# NO USER CAN LOG IN on a public deploy. Key goes in Coolify secrets, not here.
# EMAIL_PROVIDER=...
# EMAIL_API_KEY=__set_in_coolify_secrets__
# EMAIL_FROM=no-reply@themultiverse.school

# --- error tracking (optional; self-hosted GlitchTip DSN, injected via secrets) ---
# GLITCHTIP_DSN=__set_in_coolify_secrets__

# --- research engine (only when #2/#3 are wired; not needed for the stub skeleton) ---
# NOUS_RESEARCH_API_KEY=__set_in_coolify_secrets__
