#!/bin/sh
# Local defense-in-depth before a push leaves the dev machine.
# Fast dependency gate + scan the COMMIT RANGE being pushed (history, not just the tree).
node scripts/audit-deps.mjs || exit 1
z40="0000000000000000000000000000000000000000"
fail=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue                 # branch deletion
  if [ "$remote_sha" = "$z40" ]; then
    range="$local_sha --not --remotes"                  # new branch: only its new commits
  else
    range="$remote_sha..$local_sha"
  fi
  node scripts/scan-secrets.mjs --range "$range" || fail=1
done
[ "$fail" = 0 ] || exit 1
